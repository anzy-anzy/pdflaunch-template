# ------------------------------------------------------------------------------
# PDFLaunch — single-file whitelabel contract
# ------------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in YOUR values. Every variable is
# optional: the app degrades gracefully to demo mode with the defaults from
# config/product.json. There is no code to change — this file IS the contract.
#
# Environment variables override config/product.json at runtime.
# Secrets (Stripe, Resend/SendGrid) only ever live here, never in a config file.
# ------------------------------------------------------------------------------

# --- Store identity ----------------------------------------------------------
# Shown in the header / landing page. "PDFLaunch Demo Store" by default.
STORE_NAME=PDFLaunch Demo Store

# Public URL of your logo (header branding). Optional — falls back to the cover
# image, then to the 📄 mark. Serve it from /public (e.g. /logo.png) or a CDN.
STORE_LOGO_URL=/cover.png

# Support address — shown as a mailto: link in the landing footer and inside
# the delivery email. Optional.
SUPPORT_EMAIL=complainhere40@outlook.com

# --- Product ----------------------------------------------------------------
# Landing page headline + checkout line-item name.
PRODUCT_TITLE=The Founder's Guide to Automated PDF Delivery

# Landing page copy.
PRODUCT_DESCRIPTION=A practical guide to selling and delivering digital PDF products, fully automated — from checkout to watermarked download link.

# Price in the smallest currency unit (cents). 2900 = $29.00 USD.
PRODUCT_PRICE_CENTS=2900

# ISO 4217 currency code — lowercase. Defaults to "usd" (works everywhere,
# including as a Stripe fallback). Example: "eur", "gbp", "jpy" (JPY has no decimals).
PRODUCT_CURRENCY=usd

# Cover image shown on the landing page. Public path (/cover.png) or full URL.
PRODUCT_COVER_IMAGE=/cover.png

# --- Watermark ---------------------------------------------------------------
# "true" stamps buyer name + email + purchase time on every delivered page.
# "false" ships the clean PDF. Defaults to true.
WATERMARK_ENABLED=true

# Download link lifetime in hours. Defaults to 72.
DOWNLOAD_LINK_TTL_HOURS=72

# --- Stripe ------------------------------------------------------------------
# Secret key: https://dashboard.stripe.com/apikeys
# Use sk_test_... while developing, sk_live_... once selling real products.
# Without this, /api/checkout returns a demo stub and the landing flow is simulated.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret: https://dashboard.stripe.com/webhooks
# Point a webhook at https://<your-domain>/api/webhooks/stripe and subscribe to
# checkout.session.completed (checkout.session.expired is logged and ignored).
# While unset, signature verification is skipped and the payload is logged.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# [Optional] Publishable key (pk_...) — reserved for a future Stripe.js integration.
# Not currently read by the template; harmless to set now.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# --- Flutterwave (Mobile Money + local cards — Cameroon) ---------------------
# Accept MTN Mobile Money, Orange Money and local/international cards via
# Flutterwave's hosted checkout: https://dashboard.flutterwave.com
# Without this, the landing page shows Stripe-only checkout; the Mobile Money
# toggle appears automatically once FLUTTERWAVE_SECRET_KEY is set.
# Secret key (FLWSECK_TEST... while developing, FLWSECK... once live).
# Without this, /api/checkout/flutterwave returns a demo stub (records a demo
# sale + mints a demo download link) and the landing flow is simulated.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_REPLACE_ME

# Webhook verification hash: Flutterwave Dashboard → Settings → Webhooks →
# point a webhook at https://<your-domain>/api/webhooks/flutterwave, subscribe
# to charge.completed, and paste the secret hash here. The route compares the
# `verif-hash` header against this value; every charge.completed is then
# RE-VERIFIED via the API before delivery (the webhook body is never trusted).
# While unset, verification is skipped and the payload is logged (demo mode).
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_ME

# Cameroon note: Flutterwave supports MTN MoMo in Cameroon and is licensed
# there. To price in francs, set PRODUCT_CURRENCY=xaf (XAF has no minor unit,
# so PRODUCT_PRICE_CENTS is the whole-franc price — e.g. 5000 = 5,000 XAF).
# The buyer chooses MoMo/cards on Flutterwave's hosted page; after payment
# they are redirected back and fulfilled (watermark → link → email), same as
# Stripe.

# --- Email (Resend OR SendGrid — either is enough) ---------------------------
# Delivery email via Resend: https://resend.com/api-keys (re_...).
# If RESEND_API_KEY is unset, the template falls back to SENDGRID_API_KEY
# (SendGrid v3 API, https://app.sendgrid.com/settings/api_keys — SG.xxxx).
# If neither is set, the delivery link is logged to the server console instead.
RESEND_API_KEY=re_REPLACE_ME
SENDGRID_API_KEY=SG.REPLACE_ME

# Sender address for delivery emails. Must be a verified sender in Resend
# (or the From Identity in SendGrid), e.g.  Your Store <delivery@yourdomain.com>.
EMAIL_FROM=PDFLaunch <delivery@example.com>

# --- Admin password (optional but recommended in production) ------------------
# Protects /admin (dashboard + PDF upload) and /api/upload + /api/sales.
#   UNSET (default — leave the line below commented out) → the admin area is
#         OPEN — demo mode, zero configuration.
#   SET → a password form appears at /admin; /api/upload and /api/sales return
#         401 without a valid session. Login is POST /api/admin/login
#         { "password": "..." } — it sets an HttpOnly, SameSite=Lax
#         `pdflaunch_admin` cookie (HMAC token — no server state needed).
#         POST /api/admin/logout clears it. The dashboard shows "Sign out".
#
# Use a long random password. Generate one with:
#   openssl rand -base64 32        (or)   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Then uncomment and paste your generated value:
# ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# --- Public origin -----------------------------------------------------------
# The public URL of your deployed app, used to build download links in emails
# (https://yourdomain.com — no trailing slash). Unset during local dev → the
# template falls back to the incoming request's host header.
APP_BASE_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# Done. Restart `npm run dev` after editing. See README.md for the full flow.
# ------------------------------------------------------------------------------